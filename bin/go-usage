#!/usr/bin/env bun
// go-usage — mostra o usage dos planos OpenCode Go das contas logadas nesta máquina.
// Lê os tokens da conta do Console direto do SQLite do opencode (somente leitura).
// Uso: go-usage [--json] [--no-color] [--db <caminho>] [--account <email>] [--timeout <ms>]

import { Database } from "bun:sqlite";
import { homedir } from "node:os";
import { join } from "node:path";
import { existsSync } from "node:fs";

const DEFAULT_URL = "https://opencode.ai/console";
const UA =
  "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36";

const HELP = `go-usage — usage dos planos OpenCode Go

Uso:
  go-usage [opções]

Opções:
  --json              saída JSON (para scripts/statusline)
  --no-color          sem cores ANSI
  --db <caminho>      caminho do opencode.db (default: XDG data dir)
  --account <email>   filtra por email da conta (pode repetir)
  --timeout <ms>      timeout por requisição (default: 15000)
  -h, --help          mostra esta ajuda

Setup: rode \`opencode console login\` para cada conta Go.`;

function parseArgs(argv) {
  const args = { json: false, color: undefined, db: null, accounts: [], timeout: 15000, help: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--json") args.json = true;
    else if (a === "--no-color") args.color = false;
    else if (a === "-h" || a === "--help") args.help = true;
    else if (a === "--db") args.db = argv[++i];
    else if (a === "--account") args.accounts.push(argv[++i]);
    else if (a === "--timeout") args.timeout = Number(argv[++i]) || 15000;
    else if (a.startsWith("--db=")) args.db = a.slice(5);
    else if (a.startsWith("--account=")) args.accounts.push(a.slice(10));
    else if (a.startsWith("--timeout=")) args.timeout = Number(a.slice(10)) || 15000;
    else {
      console.error(`Opção desconhecida: ${a}\n`);
      console.error(HELP);
      process.exit(2);
    }
  }
  return args;
}

function resolveDb(explicit) {
  if (explicit) return explicit;
  if (process.env.GO_USAGE_DB) return process.env.GO_USAGE_DB;
  const xdg = process.env.XDG_DATA_HOME;
  const base = xdg && xdg.trim() ? join(xdg, "opencode") : join(homedir(), ".local", "share", "opencode");
  return join(base, "opencode.db");
}

function loadAccounts(db, filter) {
  const rows = db
    .query("SELECT id, email, url, access_token, refresh_token, token_expiry FROM account")
    .all();
  const active = db.query("SELECT active_account_id, active_org_id FROM account_state LIMIT 1").get();
  const want = new Set(filter);
  return rows
    .filter((r) => (want.size ? want.has(r.email) : true))
    .map((r) => ({
      id: r.id,
      email: r.email,
      url: (r.url || DEFAULT_URL).replace(/\/+$/, ""),
      token: r.access_token,
      expiry: r.token_expiry ? Number(r.token_expiry) : null,
      active: active ? active.active_account_id === r.id : false,
    }));
}

class ApiError extends Error {
  constructor(kind, status, body) {
    super(`${status}`);
    this.kind = kind;
    this.status = status;
    this.body = body;
  }
}

async function apiGet(url, token, orgId, timeout) {
  const headers = {
    Authorization: `Bearer ${token}`,
    Accept: "application/json",
    "User-Agent": UA,
  };
  if (orgId) headers["x-org-id"] = orgId;
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), timeout);
  let res;
  try {
    res = await fetch(url, { headers, signal: ctrl.signal });
  } catch (e) {
    throw new ApiError("network", 0, e?.name === "AbortError" ? "timeout" : String(e?.message || e));
  } finally {
    clearTimeout(timer);
  }
  const text = await res.text();
  if (res.status === 401) throw new ApiError("unauthorized", 401, text);
  if (res.status === 403) throw new ApiError("forbidden", 403, text);
  if (!res.ok) throw new ApiError("http", res.status, text.slice(0, 300));
  if (!text) return null;
  try {
    return JSON.parse(text);
  } catch {
    throw new ApiError("parse", res.status, text.slice(0, 300));
  }
}

function normMeter(x) {
  if (!x) return null;
  const used = Number(x.usedMicroCents);
  const limit = Number(x.limitMicroCents);
  return {
    used,
    limit,
    percent: limit > 0 ? (used / limit) * 100 : 0,
    resetsAt: x.resetsAt || null,
  };
}

function extractMeters(status) {
  const m = status?.access?.meters;
  if (!m) return null;
  const out = { fiveHour: normMeter(m.fiveHour), week: normMeter(m.week), month: normMeter(m.month) };
  return out.fiveHour || out.week || out.month ? out : null;
}

function fmtCountdown(iso) {
  if (!iso) return "—";
  const ms = new Date(iso).getTime() - Date.now();
  if (!Number.isFinite(ms)) return "—";
  if (ms <= 0) return "agora";
  const s = Math.floor(ms / 1000);
  const d = Math.floor(s / 86400);
  const h = Math.floor((s % 86400) / 3600);
  const mi = Math.floor((s % 3600) / 60);
  if (d > 0) return `${d}d ${h}h`;
  if (h > 0) return `${h}h ${mi}m`;
  return `${mi}m`;
}

const COLORS = { green: "\x1b[32m", yellow: "\x1b[33m", red: "\x1b[31m", dim: "\x1b[2m", bold: "\x1b[1m", reset: "\x1b[0m" };

function colorFor(percent) {
  if (percent >= 80) return COLORS.red;
  if (percent >= 50) return COLORS.yellow;
  return COLORS.green;
}

function bar(percent, width, color, useColor) {
  const p = Math.max(0, Math.min(100, percent));
  let filled = p <= 0 ? 0 : Math.max(1, Math.round((p / 100) * width));
  filled = Math.min(width, filled);
  const body = "█".repeat(filled) + "░".repeat(width - filled);
  return useColor ? `${color}${body}${COLORS.reset}` : body;
}

function renderRows(result, useColor) {
  const width = 28;
  const lines = [];
  const plan = result.product ? ` · ${result.product}` : "";
  const active = result.active ? " ●" : "";
  lines.push(
    (useColor ? COLORS.bold : "") + `${result.email} — ${result.orgName}${plan}${active}` + (useColor ? COLORS.reset : "")
  );
  const rows = [
    ["Rolling usage", result.fiveHour],
    ["Weekly usage", result.week],
    ["Monthly usage", result.month],
  ];
  for (const [label, meter] of rows) {
    const name = label.padEnd(15);
    if (!meter) {
      lines.push(`  ${name}[${" ".repeat(width)}]     —        —`);
      continue;
    }
    const pct = meter.percent;
    const pctStr = `${pct.toFixed(0)}% used`;
    const b = bar(pct, width, colorFor(pct), useColor);
    const reset = `Resets in ${fmtCountdown(meter.resetsAt)}`;
    lines.push(`  ${name}[${b}] ${pctStr.padStart(8)}   ${useColor ? COLORS.dim : ""}${reset}${useColor ? COLORS.reset : ""}`);
  }
  return lines;
}

function describeError(e, account) {
  switch (e.kind) {
    case "unauthorized":
      return `${account.email}: sessão expirada/ inválida — rode \`opencode console login\` nessa conta`;
    case "forbidden":
      return `${account.email}: 403 (Cloudflare/browser signature). Tente novamente; se persistir, verifique o User-Agent.`;
    case "network":
      return `${account.email}: falha de rede (${e.body})`;
    case "parse":
      return `${account.email}: resposta inválida (HTTP ${e.status})`;
    default:
      return `${account.email}: HTTP ${e.status} ${e.body || ""}`.trim();
  }
}

async function main() {
  const args = parseArgs(process.argv.slice(2));
  if (args.help) {
    console.log(HELP);
    return 0;
  }

  const dbPath = resolveDb(args.db);
  if (!existsSync(dbPath)) {
    console.error(`Banco do opencode não encontrado em: ${dbPath}`);
    console.error("Rode `opencode console login` para autenticar (ou use --db ou GO_USAGE_DB).");
    return 1;
  }

  let db;
  try {
    db = new Database(dbPath, { readonly: true });
  } catch (e) {
    console.error(`Não foi possível abrir ${dbPath}: ${e?.message || e}`);
    return 1;
  }

  let accounts;
  try {
    accounts = loadAccounts(db, args.accounts);
  } catch (e) {
    console.error(`Falha ao ler contas do banco: ${e?.message || e}`);
    return 1;
  }

  if (accounts.length === 0) {
    console.error("Nenhuma conta OpenCode Console encontrada.");
    console.error("Rode `opencode console login` para cada conta Go.");
    return 1;
  }

  const useColor = args.color === false ? false : Boolean(process.stdout.isTTY) || Boolean(process.env.FORCE_COLOR);
  const results = [];
  const errors = [];

  for (const account of accounts) {
    let orgs;
    try {
      orgs = (await apiGet(`${account.url}/api/orgs`, account.token, null, args.timeout)) || [];
    } catch (e) {
      errors.push(describeError(e, account));
      continue;
    }
    for (const org of orgs) {
      let status;
      try {
        status = await apiGet(`${account.url}/api/go/status`, account.token, org.id, args.timeout);
      } catch (e) {
        errors.push(describeError(e, account));
        continue;
      }
      const meters = extractMeters(status);
      if (!meters) continue; // org sem subscrição Go
      results.push({
        accountId: account.id,
        email: account.email,
        active: account.active,
        orgId: org.id,
        orgName: org.name,
        product: status.product || null,
        renewalProduct: status.renewalProduct || null,
        endsAt: status.access?.endsAt || null,
        subscribe: {
          renewalPending: status.renewalPending ?? null,
          cancelAtPeriodEnd: status.access?.cancelAtPeriodEnd ?? null,
          useBalance: status.useBalance ?? null,
        },
        fiveHour: meters.fiveHour,
        week: meters.week,
        month: meters.month,
      });
    }
  }

  if (args.json) {
    const payload = results.map((r) => ({
      email: r.email,
      accountId: r.accountId,
      active: r.active,
      orgId: r.orgId,
      orgName: r.orgName,
      product: r.product,
      endsAt: r.endsAt,
      fiveHour: r.fiveHour,
      week: r.week,
      month: r.month,
    }));
    console.log(JSON.stringify(payload, null, 2));
  } else {
    if (results.length === 0) {
      console.error("Nenhuma subscrição OpenCode Go encontrada nas contas logadas.");
    } else {
      results.forEach((r, i) => {
        if (i > 0) console.log("");
        renderRows(r, useColor).forEach((l) => console.log(l));
      });
    }
  }

  if (errors.length) {
    console.error("");
    errors.forEach((e) => console.error(`! ${e}`));
  }

  return results.length > 0 ? 0 : 1;
}

if (import.meta.main) {
  main()
    .then((code) => process.exit(code))
    .catch((e) => {
      console.error(`Erro inesperado: ${e?.stack || e}`);
      process.exit(1);
    });
}

export {
  parseArgs,
  resolveDb,
  loadAccounts,
  normMeter,
  extractMeters,
  fmtCountdown,
  bar,
  colorFor,
  renderRows,
  describeError,
  ApiError,
};
